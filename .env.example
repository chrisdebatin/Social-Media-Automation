# --- Pflicht im Deployment ---------------------------------------------------
# Basic-Auth-Passwort (Benutzername beliebig). Ohne dieses Passwort bleibt die App auf Vercel gesperrt.
APP_PASSWORD=

# --- KI-Text (optional – ohne Key funktioniert der manuelle Modus) -----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- KI-Bilder (optional) -----------------------------------------------------
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# AI_IMAGES=off   # KI-Bilder trotz Key abschalten

# --- Speicher (Pflicht für Instagram; öffentliche Bild-URLs) -----------------
BLOB_READ_WRITE_TOKEN=

# --- Instagram API mit Instagram-Login ---------------------------------------
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v24.0
